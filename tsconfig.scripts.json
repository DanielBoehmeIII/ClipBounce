{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/extension/background.ts",
    "src/extension/contentScript.ts",
    "src/clipbounce/**/*.ts",
    "src/utils/**/*.ts"
  ]
}
