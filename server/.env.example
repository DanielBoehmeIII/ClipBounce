# ClipBounce Server Configuration

# --- Paid API Providers ---
# Set at least one API key for Anthropic or OpenAI.
# Anthropic takes precedence if both are set.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Optional: override the default model
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# OPENAI_MODEL=gpt-4o

# --- Local LLM Provider (OpenAI-compatible, e.g. LM Studio / Ollama) ---
# Set AI_PROVIDER=local to use a local LLM instead of paid APIs.
# No paid API key is required when using local mode.
# AI_PROVIDER=local
# LOCAL_LLM_BASE_URL=http://localhost:1234/v1
# LOCAL_LLM_MODEL=<model-name>   # e.g. mistral-7b-instruct-v0.2
# LOCAL_LLM_API_KEY=lm-studio

# Server port (default: 8787)
# PORT=8787
