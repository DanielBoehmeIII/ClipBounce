# ClipBounce Server Configuration
# Set at least one API key. Anthropic takes precedence if both are set.

ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Optional: override the default model
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# OPENAI_MODEL=gpt-4o

# Server port (default: 8787)
# PORT=8787
