{
  "manifest_version": 3,
  "name": "ClipBounce",
  "version": "0.2.0",
  "description": "Prompt, group, and control many websites at once. Multi-source synthesis and tab workflow manager.",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "storage",
    "tabGroups",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "ClipBounce"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "open-clipbounce": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Open ClipBounce side panel"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
